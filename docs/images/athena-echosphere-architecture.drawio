<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.1.8">
  <diagram name="Architecture" id="arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1300">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="b_lane" value="Browsers &#8212; Next.js 16 / React 19 (apps/web)" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="580" height="640" as="geometry" />
        </mxCell>
        <mxCell id="b_teacher" value="Teacher tab &#8212; THE RELAY&#xa;control panel, lesson upload, gap dashboard,&#xa;restraint meter, inline report&#xa;(isRelay: the only tab that POSTs transcripts/state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="b_lane">
          <mxGeometry x="30" y="60" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b_student1" value="Student view&#xa;transcript, roster, quiz cards + overlay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="b_lane">
          <mxGeometry x="30" y="210" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b_student2" value="Student view (N per session)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="b_lane">
          <mxGeometry x="30" y="340" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b_libs" value="In every browser&#xa;agora-rtc-react hooks, one ref-counted RTM client,&#xa;AgoraVoiceAI toolkit, useClassroom = pure SSE mirror&#xa;(browsers never derive floor/policy/quiz state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="b_lane">
          <mxGeometry x="30" y="470" width="520" height="140" as="geometry" />
        </mxCell>

        <mxCell id="a_lane" value="Agora Cloud (owned by Agora, billed through the one project)" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="560" height="640" as="geometry" />
        </mxCell>
        <mxCell id="a_rtc" value="RTC channel &#8212; live audio&#xa;teacher + students + Athena (fixed uid 123456)&#xa;human uids from a disjoint random range" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="a_lane">
          <mxGeometry x="30" y="60" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a_convo" value="ConvoAI engine = Athena&#xa;Deepgram nova-3 STT &#8594; gpt-4o-mini &#8594; MiniMax TTS&#xa;(Sarvam option for Indian languages)&#xa;answers every user turn on its own initiative&#xa;never asks the orchestrator first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="a_lane">
          <mxGeometry x="30" y="200" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="a_rtm" value="RTM channel&#xa;agent transcript + AGENT_STATE&#xa;(browser-only SDK, no server variant &#8594; this is why&#xa;the control path cannot ride RTM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="a_lane">
          <mxGeometry x="30" y="370" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a_skip" value="MiniMax skipPatterns [5] strips {json} control objects before TTS, so Athena never speaks them" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="a_lane">
          <mxGeometry x="30" y="510" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="o_lane" value="Orchestrator (apps/orchestrator) &#8212; Fastify, Node 22, long-lived single process = the brain (single authoritative writer; AgentSession handle must stay in memory)" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1280" height="380" as="geometry" />
        </mxCell>
        <mxCell id="o_routes" value="REST routes&#xa;/join /transcript /agent-state /command&#xa;/quiz /prompt /agent/history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="o_lane">
          <mxGeometry x="30" y="60" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o_ctrl" value="classroomController&#xa;requestFloor(): the ONE door&#xa;that can make Athena talk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="o_lane">
          <mxGeometry x="285" y="60" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o_agent" value="agentLifecycle (agora-agents)&#xa;start / stop / interrupt /&#xa;think / update / getHistory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="o_lane">
          <mxGeometry x="540" y="60" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o_quiz" value="quizEngine&#xa;sets of 3, 15s deadline, answer&#xa;normalise, proficiency feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="o_lane">
          <mxGeometry x="795" y="60" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o_reg" value="SessionRegistry (in-memory)&#xa;ClassroomSession = source of truth&#xa;live AgentSession lives here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="o_lane">
          <mxGeometry x="1050" y="60" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o_bus" value="Event bus &#8594; SSE fan-out&#xa;publish / publishToTeachers / publishTo&#xa;gap data is teacher-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="o_lane">
          <mxGeometry x="30" y="220" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o_floor" value="Floor machine + speak permit&#xa;decideSpeak() is pure, muted checked first&#xa;permit TTL 15s, after-the-fact interrupt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="o_lane">
          <mxGeometry x="285" y="220" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o_prompt" value="prompt.ts&#xa;whole classroom pushed into the system prompt&#xa;via update() &#8212; must repeat model every time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="o_lane">
          <mxGeometry x="540" y="220" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o_gaps" value="gapDetector&#xa;wrong answers + confused speech&#xa;+ {gap} &#8594; 2+ students = class-wide" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="o_lane">
          <mxGeometry x="795" y="220" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o_lesson" value="LessonStore + report&#xa;chunks + hashed embeddings; deterministic report;&#xa;narrative via llm/complete.ts (key optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="o_lane">
          <mxGeometry x="1050" y="220" width="225" height="100" as="geometry" />
        </mxCell>

        <mxCell id="pg" value="Postgres&#xa;(optional)&#xa;flush ONCE at&#xa;session end" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
