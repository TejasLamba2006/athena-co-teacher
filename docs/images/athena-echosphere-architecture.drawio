  <diagram name="Runtime-Flows" id="flows">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="1400">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="f_title" value="Transcript pipeline (teacher tab is the only relay)" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="ConvoAI re-emits cumulative turns over RTM (same turn_id grows)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="Relay holds a turn until text stops changing for 1.2s; force-publishes at 2.5s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="Speaker attribution: 150ms volume poll across all tracks; loudest wins, fixed at first sight, confidence = best/(best+second)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="POST /transcript to orchestrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="Dedupe by (uid,turnId); a grown re-emit replaces the stored turn in place" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="stripSelfEcho: subtract anything Athena said in the last 10s, keep the remainder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="Append + floor transition + wake-word check + gap check ([classroom:system] text dropped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="Broadcast echosphere:transcript to every browser via SSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="g_title" value="Speak-permit enforcement loop (ConvoAI never asks permission first)" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="440" y="30" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="Browser relays AGENT_STATE: thinking / speaking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="authorizedTurnInProgress?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="170" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="Let the turn run (authorization covers the whole turn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="185" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="Muted OR no valid permit (TTL 15s)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="310" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="interruptAgent() + clear permit + meter held-back + tell teacher panel (agent-blocked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="325" width="220" height="70" as="geometry" />
